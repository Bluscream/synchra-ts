{
  "name": "synchra-ts",
  "version": "0.1.0",
  "description": "TypeScript client for the Synchra API — complete REST coverage and the realtime gateway, generated from the annotated OpenAPI description.",
  "keywords": [
    "synchra",
    "twitch",
    "youtube",
    "tiktok",
    "kick",
    "streaming",
    "chat",
    "api",
    "client",
    "sdk"
  ],
  "license": "MIT",
  "author": "Bluscream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bluscream/synchra-ts.git"
  },
  "homepage": "https://github.com/Bluscream/synchra-ts#readme",
  "bugs": "https://github.com/Bluscream/synchra-ts/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "tsx tools/generate.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^5.0.3"
  }
}
